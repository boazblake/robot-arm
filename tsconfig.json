{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": [
      "ESNext",
      "DOM"
    ],
    "moduleResolution": "Node",
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@components/*": [
        "src/shared/components/*"
      ],
      "@models/*": [
        "src/models/*"
      ],
      "@pages/*": [
        "src/features/*"
      ],
      "@utils/*": [
        "src/shared/utils/*"
      ]
    }
  },
  "include": [
    "src",
    "types",
    "mithril-stream.d.ts"
  ]
}
