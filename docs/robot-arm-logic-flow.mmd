%% Robot Arm — application logic and data propagation
%% Solid edges = current runtime wiring. Dashed edges = implemented domain contracts
%% not yet connected to the tracking UI/session orchestration.
flowchart TD

    BOOT([Application starts]) --> DIAG[Install dev error diagnostics]
    DIAG --> IONIC[Load Ionic runtime]
    IONIC --> ROUTER[Mount Mithril router]
    ROUTER --> ROUTES{Route?}
    ROUTES -->|/ or /tracking| LAYOUT[Render Layout]
    LAYOUT --> TRACKING[Render Tracking feature]
    TRACKING --> VIEWER[PoseViewer]
    VIEWER --> CONTROLS[Start / stop controls]

    subgraph SESSION[Tracking session — src/features/tracking/session.service.ts]
        CONTROLS --> ACTION{User action}
        ACTION -->|Start| GUARD{Already starting or Streaming?}
        GUARD -->|Yes| NOOP([Return; no state change])
        GUARD -->|No| CLEAR[Clear startup error]
        CLEAR --> RESTART{State is Stopped?}
        RESTART -->|Yes| RESET[transition restart → Idle]
        RESTART -->|No| START[transition start → Loading]
        RESET --> START
        ACTION -->|Stop| STOP_RENDER[Stop render loop]
        STOP_RENDER --> STOP_HOLISTIC[Close holistic service]
        STOP_HOLISTIC --> STOP_CAMERA[Stop camera]
        STOP_CAMERA --> STOP_STATE[transition stop → Stopped]
    end

    START --> CAMERA_INIT

    subgraph CAMERA[Camera lifecycle — src/features/tracking/camera.service.ts]
        CAMERA_INIT[Initialize camera] --> PLATFORM{Capacitor platform?}
        PLATFORM -->|Web| GET_MEDIA[getUserMedia]
        GET_MEDIA --> VIDEO[Attach MediaStream to video]
        VIDEO --> METADATA[Wait for loadedmetadata]
        METADATA --> PLAY[Play video]
        PLATFORM -->|Native| PREVIEW[Start CameraPreview]
        PREVIEW --> NATIVE_OK{Native start succeeds?}
        NATIVE_OK -->|Yes| CAMERA_READY[Set camera.ready(true)]
        NATIVE_OK -->|No| FALLBACK[Fallback to web camera]
        FALLBACK --> GET_MEDIA
        PLAY --> CAMERA_READY
    end

    CAMERA_READY --> DETECTOR_INIT

    subgraph DETECTION[Detector lifecycle and frame acquisition — src/features/tracking/holistic.service.ts]
        DETECTOR_INIT[Initialize detectors] --> WEB_MODE{Web platform?}
        WEB_MODE -->|Web| LOAD_VISION[Load MediaPipe Tasks Vision]
        LOAD_VISION --> CREATE_DETECTORS[Create pose, hand, and face landmarkers]
        CREATE_DETECTORS --> START_LOOPS[Start render loop and frame loop]
        WEB_MODE -->|Native| LISTENER[Register holisticResults listener]
        LISTENER --> START_LOOPS
        START_LOOPS --> READY[transition ready → Ready]
        READY --> STREAMING[transition beginStreaming → Streaming]

        STREAMING --> FRAME_LOOP{Frame loop running?}
        FRAME_LOOP -->|No| WAIT([Wait])
        FRAME_LOOP -->|Yes / Web| WEB_FRAME[Read HTMLVideoElement]
        WEB_FRAME --> PLAYING{Video playing and detectors ready?}
        PLAYING -->|No| NEXT_FRAME[Request next animation frame]
        PLAYING -->|Yes| SOURCE_TS[Capture sourceTimestamp = Date.now()]
        SOURCE_TS --> DETECTOR_TS[Create detector timestamp from performance.now()]
        DETECTOR_TS --> FORK{{Run detectors independently}}
        FORK --> POSE_DETECT[Pose detector]
        FORK --> HAND_DETECT[Hand detector]
        FORK --> FACE_DETECT[Face detector]
        POSE_DETECT --> DETECT_JOIN{{Join detector results}}
        HAND_DETECT --> DETECT_JOIN
        FACE_DETECT --> DETECT_JOIN
        DETECT_JOIN --> WEB_NORMALIZE[normalizeWebTrackingResults]

        STREAMING --> NATIVE_FRAME[Native: captureSample]
        NATIVE_FRAME --> SAMPLE{Sample exists?}
        SAMPLE -->|Yes| SEND[CapacitorMediaPipe.send(image)]
        SEND --> RESULT[holisticResults event]
        RESULT --> NATIVE_NORMALIZE[normalizeTrackingResult]
        SAMPLE -->|No| NEXT_FRAME
    end

    CREATE_DETECTORS -->|Initialization failure| ROLLBACK
    CAMERA_READY -->|Initialization failure| ROLLBACK

    subgraph ERROR[Startup failure — session rollback]
        ROLLBACK[Catch startup error] --> CLOSE_DETECTORS[Close holistic service]
        CLOSE_DETECTORS --> STOP_DEVICE[Stop camera]
        STOP_DEVICE --> ERROR_TEXT[Set startupError(message)]
        ERROR_TEXT --> ERROR_STATE[transition error → Idle]
    end

    subgraph BOUNDARY[Untrusted result boundary — src/integration/normalize.ts]
        WEB_NORMALIZE --> NORMALIZE
        NATIVE_NORMALIZE --> NORMALIZE
        NORMALIZE[Read unknown result] --> ROOT[Resolve data/root wrapper]
        ROOT --> TIMESTAMP[Resolve source timestamp]
        TIMESTAMP --> LANDMARKS[Validate finite x, y, z]
        LANDMARKS --> VISIBILITY[Validate optional visibility]
        VISIBILITY --> COLLECTIONS[Normalize pose, hand, and face collections]
        COLLECTIONS --> HANDS[Assign left/right hands from explicit fields or handedness]
        HANDS --> FRAME([Frozen TrackingFrame])
    end

    FRAME --> STORE[tracking.frame(TrackingFrame)]
    STORE --> REDRAW[Mithril stream invalidates dependent views]
    REDRAW --> VIEWER
    FRAME --> RENDER

    subgraph RENDERING[Canvas rendering — src/features/tracking/render.service.ts]
        RENDER[Read latest frame and render flags] --> SIZE[Resize canvas]
        SIZE --> MAP[Select contain/cover preview mapper]
        MAP --> POSE_FLAG{Pose enabled?}
        POSE_FLAG -->|Yes| DRAW_POSE[Draw pose landmarks/skeleton]
        POSE_FLAG -->|No| HAND_FLAG
        DRAW_POSE --> HAND_FLAG{Hands enabled?}
        HAND_FLAG -->|Yes| DRAW_HANDS[Draw left/right hand skeletons]
        HAND_FLAG -->|No| FACE_FLAG
        DRAW_HANDS --> FACE_FLAG{Face enabled?}
        FACE_FLAG -->|Yes| DRAW_FACE[Draw face landmarks]
        FACE_FLAG -->|No| NEXT_FRAME
        DRAW_FACE --> NEXT_FRAME
    end

    subgraph DOMAIN[Robot-independent domain contracts — src/domain]
        FRAME -.-> ARM_POSE[createHumanArmPose]
        ARM_POSE --> ARM_DATA[HumanArm: left? right?]
        FRAME -. confidence evidence .-> VALIDITY[TrackingValidity]
        ARM_DATA -. structural evidence .-> VALIDITY
        ARM_DATA --> CALIBRATE[Explicit calibrateArm]
        CALIBRATE --> CALIBRATION[ArmCalibration]
        CALIBRATION --> DISPLACEMENT[calculateArmDisplacement]
        ARM_DATA -. current arm .-> DISPLACEMENT
        VALIDITY --> MAPPING[Req 13/14 mapping]
        DISPLACEMENT --> MAPPING
        MAPPING --> TARGET[RobotTarget]
    end

    subgraph FUTURE[Later safety and transport boundaries]
        TARGET --> CONTROL[Req 16 control enablement / E-stop]
        TARGET --> FRESHNESS[Req 17 stale-input policy]
        CONTROL --> ADAPTER[Req 18 RobotAdapter]
        FRESHNESS --> ADAPTER
    end

    classDef current fill:#dcfce7,stroke:#15803d,color:#14532d
    classDef boundary fill:#dbeafe,stroke:#2563eb,color:#1e3a8a
    classDef decision fill:#fef3c7,stroke:#b45309,color:#78350f
    classDef future fill:#f3e8ff,stroke:#9333ea,color:#581c87
    classDef error fill:#fee2e2,stroke:#dc2626,color:#7f1d1d

    class BOOT,DIAG,IONIC,ROUTER,ROUTES,LAYOUT,TRACKING,VIEWER,CONTROLS current
    class FRAME,STORE,REDRAW,NORMALIZE,ROOT,TIMESTAMP,LANDMARKS,VISIBILITY,COLLECTIONS,HANDS boundary
    class GUARD,RESTART,PLATFORM,NATIVE_OK,PLAYING,SAMPLE,POSE_FLAG,HAND_FLAG,FACE_FLAG decision
    class ROLLBACK,CLOSE_DETECTORS,STOP_DEVICE,ERROR_TEXT,ERROR_STATE error
    class ARM_POSE,ARM_DATA,VALIDITY,CALIBRATE,CALIBRATION,DISPLACEMENT,MAPPING,TARGET,CONTROL,FRESHNESS,ADAPTER future

