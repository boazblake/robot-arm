{
  "name": "lift-mate",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "404": "cp docs/index.html docs/404.html",
    "clean": "rm -rf docs",
    "dev": "cross-env MODE=$MODE vite --mode $MODE --host",
    "ionic:serve": "cross-env MODE=$MODE vite --mode $MODE",
    "ionic:build": "npm run clean && cross-env MODE=$MODE vite build --mode $MODE && npm run 404",
    "build": "cross-env MODE=$MODE npm run ionic:build",
    "preview": "vite preview",
    "test:e2e": "cypress run",
    "test:unit": "vitest",
    "sync:ios": "MODE=mobile npx @ionic/cli cap sync ios",
    "sync:android": "MODE=mobile npx @ionic/cli cap sync android",
    "sync": "npm run sync:ios",
    "lint": "eslint .",
    "run:ios": "MODE=mobile npx @ionic/cli cap run ios -l --external ",
    "run:android": "MODE=mobile npx @ionic/cli cap run android -l --external",
    "make:assets": "npx capacitor-assets generate",
    "ingest:exrx": "node scripts/exrx-ingest.mjs",
    "goios": "npm run run:ios --",
    "goweb": "MODE=ssl npm run dev",
    "free:web": "sh -c 'pids=$(lsof -tiTCP:8101 -sTCP:LISTEN); [ -n \"$pids\" ] && kill $pids || true'",
    "reset:web": "npm run free:web && rm -rf node_modules/.vite",
    "buildweb": "MODE=ssl npm run build",
    "buildios": "MODE=mobile npm run build",
    "buildandroid": "MODE=mobile npm run build",
    "startios": "npm run buildios && npm run goios",
    "goandroid": "npm run run:android",
    "startandroid": "npm run buildandroid && npm run goandroid",
    "startweb": "npm run buildweb && npm run goweb",
    "make:certs": "mkdir -p .cert && mkcert -key-file ./.cert/key.pem -cert-file ./.cert/cert.pem 'localhost'"
  },
  "dependencies": {
    "@capacitor-community/camera-preview": "^7.0.5",
    "@capacitor/android": "^7.6.4",
    "@capacitor/app": "^7.1.2",
    "@capacitor/camera": "^7.0.5",
    "@capacitor/core": "^7.6.4",
    "@capacitor/filesystem": "^7.1.1",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "^7.6.4",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/share": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@ionic/core": "^8.8.6",
    "@ionic/pwa-elements": "^3.4.0",
    "@mediapipe/tasks-vision": "^0.10.22-rc.20250304",
    "@tensorflow/tfjs": "^4.21.0",
    "capacitor-media-pipe": "file:../capacitor-media-pipe",
    "ionicons": "^8.0.13",
    "mithril": "^2.2.8",
    "mithril-stream": "^2.0.0",
    "ramda": "^0.30.1",
    "sanitize-filename": "^1.6.3",
    "setimmediate": "^1.0.5",
    "vite-plugin-node-polyfills": "^0.23.0",
    "webrtc-adapter": "^9.0.3",
    "winston": "^3.11.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@bunchtogether/vite-plugin-flow": "^1.0.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.4",
    "@google/gemini-cli": "^0.1.9",
    "@ionic/cli": "^7.2.1",
    "@types/mithril": "^2.2.7",
    "@vitejs/plugin-legacy": "^6.1.1",
    "cross-env": "^7.0.3",
    "vite": "^6.3.5",
    "vite-plugin-mkcert": "^1.17.6",
    "vite-plugin-pwa": "^1.0.0",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "description": "An Ionic-Mithril app for fitness tracking"
}
